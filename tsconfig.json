{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "build",
    "noImplicitAny": false,
    "module": "ESNext",
    "target": "ES2017",
    "lib": ["DOM", "ESNext"],
    "strict": false,
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "build", "test"]
}
