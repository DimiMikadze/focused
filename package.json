{
  "name": "focused",
  "description": "Improve focus and increase productivity by blocking distracting websites while working or studying.",
  "version": "2.0.0",
  "scripts": {
    "start": "webpack --watch --mode development",
    "build": "rimraf build && webpack --mode production",
    "lint": "eslint . --ext .ts --fix --max-warnings=0",
    "test:unit": "jest ./src",
    "test:unit:watch": "yarn test:unit --watch",
    "test:e2e": "jest -c test/config/jest.config.json --runInBand ",
    "test:e2e:watch": "yarn test:e2e --watch",
    "test": "yarn test:unit && yarn test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dimimikadze/focused"
  },
  "keywords": [
    "focused",
    "chrome",
    "extension"
  ],
  "author": "Dimi Mikadze",
  "bugs": {
    "url": "https://github.com/dimimikadze/focused/issues"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-typescript": "^7.23.0",
    "@types/chrome": "^0.0.254",
    "@types/jest": "^29.5.0",
    "@types/jest-environment-puppeteer": "^5.0.0",
    "@types/puppeteer": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "babel-jest": "^29.5.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.0",
    "dotenv": "^16.0.0",
    "eslint": "^8.50.0",
    "html-webpack-plugin": "^5.5.0",
    "husky": "^8.0.0",
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "ts-jest": "^29.1.0",
    "mini-css-extract-plugin": "^2.7.0",
    "css-minimizer-webpack-plugin": "^5.0.0",
    "puppeteer": "^19.11.1",
    "rimraf": "^5.0.0",
    "style-loader": "^3.3.0",
    "terser-webpack-plugin": "^5.3.0",
    "ts-loader": "^9.5.0",
    "typescript": "^5.2.0",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.0"
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/eslint-recommended",
      "plugin:@typescript-eslint/recommended"
    ]
  },
  "eslintIgnore": [
    "node_modules",
    "build"
  ],
  "husky": {
    "hooks": {
      "pre-push": "yarn lint && yarn test"
    }
  },
  "license": "MIT",
  "dependencies": {}
}
